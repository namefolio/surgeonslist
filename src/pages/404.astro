---
import Base from '../layouts/Base.astro';
import { site } from '../../site.config';
---
<Base title="Page not found" description="This page does not exist." path="/404/" noindex markdown={false}>
  <h1>Page not found</h1>
  <p>The page may have moved, or the listing may have been removed.</p>
  <ul>
    <li><a href="/">Home</a></li>
    <li><a href={`/${site.hub}/`}>{site.entity.Many} by {site.regionWord}</a></li>
  </ul>
</Base>
