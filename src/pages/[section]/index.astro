---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Tiles from '../../components/Tiles.astro';
import SearchForm from '../../components/SearchForm.astro';
import { site } from '../../../site.config';
import { getModel } from '../../lib/data';
import { breadcrumbLd } from '../../lib/seo';

// /{hub}/ lists regions and cities; /{taxonomy}/ lists terms.
export async function getStaticPaths() {
  const m = await getModel();
  return [
    { params: { section: site.hub }, props: { kind: 'hub' } },
    ...(m.terms.length ? [{ params: { section: site.taxonomy.segment }, props: { kind: 'taxonomy' } }] : []),
  ];
}
const { kind } = Astro.props as { kind: 'hub' | 'taxonomy' };
const m = await getModel();
const path = `/${Astro.params.section}/`;
const name = kind === 'hub' ? `${site.entity.Many} by ${site.regionWord}` : `${site.entity.Many} by ${site.taxonomy.label.toLowerCase()}`;
const crumbs = [{ name: 'Home', path: '/' }, { name, path }];
const title = `${name}: ${m.published.length} listed`;
const description = kind === 'hub'
  ? `Browse ${m.published.length} ${site.entity.many} in ${m.regions.length} ${site.regionWord}${m.regions.length === 1 ? '' : 's'}, then by city.`
  : `Browse ${site.entity.many} by ${site.taxonomy.label.toLowerCase()}: ${m.terms.map((t) => t.plural.toLowerCase()).join(', ')}.`;
---
<Base title={title} description={description} path={path} noindex={m.published.length < 3} jsonld={[breadcrumbLd(crumbs)]}>
  <Crumbs items={crumbs} />
  <header class="page-head">
    <h1>{name}</h1>
    <p class="lede">{kind === 'hub'
      ? `${m.published.length} ${site.entity.many} listed in ${m.regions.length} ${site.regionWord}${m.regions.length === 1 ? '' : 's'}. Choose a ${site.regionWord}, then a city.`
      : `${m.published.length} ${site.entity.many} listed. Choose a ${site.taxonomy.label.toLowerCase()} to see every listing for it.`}</p>
  </header>
  {kind === 'hub' ? (
    m.regions.length ? (
      <div class="region-list">
        {m.regions.map((r) => (
          <section class="section" aria-labelledby={`r-${r.slug}`}>
            <div class="section-head">
              <h2 id={`r-${r.slug}`}><a href={r.url}>{r.name}</a></h2>
              <span class="muted small">{r.listings.length} listed in {r.cities.length} {r.cities.length === 1 ? 'city' : 'cities'}</span>
            </div>
            <Tiles compact items={r.cities.map((c) => ({ href: c.url, label: c.name, count: c.listings.length }))} />
          </section>
        ))}
      </div>
    ) : (
      <div class="state"><h2>No listings are published yet</h2><p>Know {site.entity.a} who should be listed?</p><div class="actions"><a class="button primary" href="/add-your-business/">Add a listing</a></div></div>
    )
  ) : (
    <Tiles items={m.terms.map((t) => ({ href: t.url, label: t.plural, count: t.listings.length }))} />
  )}
  <section class="section panel panel-tint" aria-labelledby="search-h">
    <h2 id="search-h">Looking for someone specific?</h2>
    <SearchForm id="sec" selects={false} />
  </section>
</Base>
