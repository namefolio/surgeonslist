---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { site } from '../../../site.config';
import { DAYS } from '../../lib/schema';
import { breadcrumbLd } from '../../lib/seo';
import { verifiedOpen, comingSoon } from '../../lib/tiers';

// Zero client JS: the Worker fills in ?listing= and ?tier=verified server-side (src/worker.ts).
const TEST_SITE_KEY = '1x00000000000000000000AA'; // Cloudflare's always-pass test key, local dev only
const siteKey = import.meta.env.DEV ? TEST_SITE_KEY : site.turnstileSiteKey;
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Add or update a listing', path: '/add-your-business/' }];
const e = site.entity;
const regionOptions = Object.values(site.regions).sort((a, b) => a.name.localeCompare(b.name));
---
<Base title={`Add or update a ${e.one} listing`} description={verifiedOpen ? `Send a new ${e.one} listing or a correction. Basic listings are free; Verified listings are paid and ${site.tiers.checkedShort}.` : `Send a new ${e.one} listing or a correction. Every listing is free.`} path="/add-your-business/" jsonld={[breadcrumbLd(crumbs)]}>
  {siteKey && <script slot="head" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <Crumbs items={crumbs} />
  <header class="page-head">
    <span class="eyebrow">For {e.many} and patients</span>
    <h1>Add or update a listing</h1>
    <p class="lede">Send a new listing or a correction. We review every submission by hand. {verifiedOpen ? 'Basic is free; Verified is paid.' : 'Every listing is free.'} <a href="/listing-plans/">Compare listing plans</a>.</p>
  </header>
  <p id="update-note" class="notice" hidden>You are sending an update for&nbsp;<strong id="update-name">this listing</strong>.</p>

  <form class="form-card" method="post" action="/add-your-business/">
    <input type="hidden" name="listing" value="" />
    <fieldset>
      <legend>Listing plan</legend>
      <div class="radio-cards">
        <label class="radio-card"><input type="radio" name="tier" value="basic" checked /><span><strong>Basic (free)</strong>Public details, shown with the date they were last updated.</span></label>
        {verifiedOpen
          ? <label class="radio-card"><input type="radio" name="tier" value="verified" /><span><strong>Verified ({site.tiers.price})</strong>For owners and staff only. We check the {site.tiers.credential} before the label appears.</span></label>
          : <label class="radio-card"><input type="radio" name="tier" value="verified" disabled /><span><strong>Verified ({comingSoon.toLowerCase()})</strong>A paid option for owners and staff. Not available yet.</span></label>}
      </div>
    </fieldset>

    <div class="form-section">
    <h2>Practice details</h2>
    <div class="field"><label for="f-name">{site.formLabels.name}</label><input id="f-name" name="name" type="text" required maxlength="120" autocomplete="organization" /></div>
    <div class="field"><label for="f-street">Street address</label><input id="f-street" name="streetAddress" type="text" maxlength="160" autocomplete="street-address" /></div>
    <div class="field-row">
    <div class="field"><label for="f-city">City</label><input id="f-city" name="locality" type="text" required maxlength="80" autocomplete="address-level2" /></div>
    <div class="field"><label for="f-region">{site.regionWord[0]!.toUpperCase() + site.regionWord.slice(1)}</label>
      <select id="f-region" name="region" required autocomplete="address-level1">
        <option value="">Choose…</option>
        {regionOptions.map((r) => <option value={r.code}>{r.name}</option>)}
      </select>
    </div>
    <div class="field"><label for="f-postal">{site.formLabels.postal}</label><input id="f-postal" name="postalCode" type="text" maxlength="12" autocomplete="postal-code" /></div>
    </div>
    <div class="field"><label for="f-phone">Phone</label><input id="f-phone" name="phone" type="tel" maxlength="40" autocomplete="tel" /></div>
    <div class="field"><label for="f-web">Website</label><input id="f-web" name="website" type="url" maxlength="300" placeholder="https://" /></div>
    <div class="field"><label for="f-same">Social or profile links (one per line)</label><textarea id="f-same" name="sameAs" maxlength="1000"></textarea></div>

    </div>

    <details class="more">
      <summary>More details (optional)</summary>
      <fieldset>
        <legend>Hours (for example 09:00-17:00, or "closed")</legend>
        <div class="hours-grid">
          {DAYS.map((d) => <div><label for={`h-${d}`}>{d[0]!.toUpperCase() + d.slice(1)}</label><input id={`h-${d}`} name={`hours_${d}`} type="text" maxlength="40" /></div>)}
        </div>
      </fieldset>
      {site.formFields.map((f) =>
        f.type === 'multi' ? (
          <fieldset><legend>{f.label}</legend><div class="check-grid">{f.options!.map(([v, l]) => <label class="check"><input type="checkbox" name={f.name} value={v} /> {l}</label>)}</div></fieldset>
        ) : f.type === 'select' ? (
          <div class="field"><label for={`a-${f.name}`}>{f.label}</label><select id={`a-${f.name}`} name={f.name}><option value="">Not sure</option>{f.options!.map(([v, l]) => <option value={v}>{l}</option>)}</select></div>
        ) : f.type === 'bool' ? (
          <div class="field"><label for={`a-${f.name}`}>{f.label}</label><select id={`a-${f.name}`} name={f.name}><option value="">Not sure</option><option value="yes">Yes</option><option value="no">No</option></select></div>
        ) : f.type === 'lines' ? (
          <div class="field"><label for={`a-${f.name}`}>{f.label}</label><textarea id={`a-${f.name}`} name={f.name} maxlength="1000"></textarea></div>
        ) : (
          <div class="field"><label for={`a-${f.name}`}>{f.label}</label><input id={`a-${f.name}`} name={f.name} type="text" maxlength="200" /></div>
        ),
      )}
    </details>

    <div class="field"><label for="f-desc">Short description or correction</label><textarea id="f-desc" name="description" maxlength="1200"></textarea></div>

    <fieldset class="form-section">
      <legend class="sr-only">About you (not published)</legend>
      <h2 aria-hidden="true">About you <span class="muted small">(not published)</span></h2>
      <div class="field"><label for="f-sname">Your name</label><input id="f-sname" name="submitterName" type="text" required maxlength="100" autocomplete="name" /></div>
      <div class="field"><label for="f-semail">Your email</label><input id="f-semail" name="submitterEmail" type="email" required maxlength="200" autocomplete="email" /></div>
      <div class="field"><label for="f-rel">Your relationship to the {e.one}</label>
        <select id="f-rel" name="relationship" required>
          <option value="">Choose…</option>
          <option value="owner">Owner</option>
          <option value="staff">Staff</option>
          <option value="customer">{site.formLabels.customer}</option>
        </select>
      </div>
      {verifiedOpen && <p class="muted small">Only an owner or staff member can request Verified. Corrections from anyone else are handled as Basic.</p>}
    </fieldset>

    <div class="hp" aria-hidden="true"><label for="f-hp">Leave this empty</label><input id="f-hp" name="fax" type="text" tabindex="-1" autocomplete="off" /></div>
    <label class="check"><input type="checkbox" name="consent" value="yes" required /> I agree that {site.name} may publish the business details above (not my own contact details) and contact me about this listing.</label>
    {siteKey ? <div class="cf-turnstile" data-sitekey={siteKey}></div> : <p class="muted small">If the form does not send, email <a href={`mailto:${site.submissionsEmail}`}>{site.submissionsEmail}</a>.</p>}
    <div class="actions"><button class="button primary" type="submit">Send listing details</button></div>
  </form>
</Base>
