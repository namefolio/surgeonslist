---
import Base from '../../../layouts/Base.astro';
import { site } from '../../../../site.config';
import Icon from '../../../components/Icon.astro';
---
<Base title="Your details were not sent" description="The listing form could not send your details." path="/add-your-business/error/" noindex markdown={false}>
  <div class="state" style="margin-top: 2rem">
    <Icon name="info" class="icon icon-lg" />
    <h1>Your details were not sent</h1>
    <p>Something went wrong, or a required field was missing. Nothing was stored.</p>
    <p>Please try the form again, or email the same details to <a href={`mailto:${site.submissionsEmail}`}>{site.submissionsEmail}</a>.</p>
    <div class="actions"><a class="button primary" href="/add-your-business/">Try the form again</a></div>
  </div>
</Base>
