---
import Base from '../../../layouts/Base.astro';
import { site } from '../../../../site.config';
---
<Base title="Your details were not sent" description="The listing form could not send your details." path="/add-your-business/error/" noindex markdown={false}>
  <h1>Your details were not sent</h1>
  <div class="prose">
    <p>Something went wrong, or a required field was missing. Nothing was stored.</p>
    <p>Please <a href="/add-your-business/">try the form again</a>, or email the same details to <a href={`mailto:${site.submissionsEmail}`}>{site.submissionsEmail}</a>.</p>
  </div>
</Base>
