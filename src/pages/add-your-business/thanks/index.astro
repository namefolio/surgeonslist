---
import Base from '../../../layouts/Base.astro';
import { site } from '../../../../site.config';
---
<Base title="Thanks, we have your details" description="Your listing details were sent." path="/add-your-business/thanks/" noindex markdown={false}>
  <h1>Thanks, we have your details</h1>
  <p class="prose">We add or update Basic listings by hand, usually within a few days. We check new details against public sources before they go live, and we never publish your own contact details.</p>
  <p><a href={`/${site.hub}/`}>Back to the {site.entity.many}</a></p>
</Base>
