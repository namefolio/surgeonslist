---
import Base from '../../../layouts/Base.astro';
import { site } from '../../../../site.config';
import Icon from '../../../components/Icon.astro';
---
<Base title="Thanks, we have your details" description="Your listing details were sent." path="/add-your-business/thanks/" noindex markdown={false}>
  <div class="state" style="margin-top: 2rem">
    <Icon name="checkCircle" class="icon icon-lg" />
    <h1>Thanks, we have your details</h1>
    <p>We add or update Basic listings by hand, usually within a few days. We check new details against public sources before they go live, and we never publish your own contact details.</p>
    <div class="actions"><a class="button primary" href={`/${site.hub}/`}>Back to the {site.entity.many}</a></div>
  </div>
</Base>
