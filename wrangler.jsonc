{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "surgeonslist",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker runs only for the form and its Verified thanks page; everything else is served as static files.
    "run_worker_first": ["/add-your-business/", "/add-your-business/thanks-verified/"]
  },
  // Email Routing must be on for the domain, with the submissions inbox verified as a destination.
  "send_email": [{ "name": "SUBMISSIONS" }],
  "observability": { "enabled": true }
  // Secret: wrangler secret put TURNSTILE_SECRET
}
